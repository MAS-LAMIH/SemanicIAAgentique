@prefix seq: <https://example.org/sam/sequence/v1#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:sequence-profile:b> a seq:Profile ;
    seq:base_manual "contracts/providers/b.ttl" ;
    seq:create_path_template "/booking-after/{id}" ;
    seq:effect "ReservationOnly" ;
    seq:operation_id "urn:sequence:reserveAfterBooking" ;
    seq:requires_after_end true ;
    seq:requires_predecessor true ;
    seq:version 1 .

