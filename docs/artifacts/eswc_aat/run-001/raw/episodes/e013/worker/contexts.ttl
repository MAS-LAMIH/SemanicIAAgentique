@prefix ns1: <urn:eswc:aat:prototype:1#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:agent:semantic> a ns1:Agent ;
    ns1:observedContext <urn:context:98e0d5e4-e081-469b-81f4-3f75c60cb00c> ;
    ns1:pursuesGoal <urn:goal:room> .

<urn:context:98e0d5e4-e081-469b-81f4-3f75c60cb00c> a ns1:ContextSnapshot ;
    ns1:coolerReady true ;
    ns1:heaterReady true ;
    ns1:mutationCount 0 ;
    ns1:observedAt "2000-01-01T00:00:00+00:00" ;
    ns1:revision 0 ;
    ns1:sentinelState "{\"lamp\": \"off\", \"marker\": {\"untouched\": true}}"^^rdf:JSON ;
    ns1:subject <urn:example:room:thing> ;
    ns1:temperatureC 21 .

<urn:goal:room> a ns1:Goal ;
    ns1:maxEvidenceAgeSeconds 1e+01 ;
    ns1:subject <urn:example:room:thing> ;
    ns1:temperatureC 22 .

