{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "start_time",
          "end_time",
          "title"
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          "https://example.org/sam/v1#PositiveInterval",
          "https://example.org/sam/v1#CalendarWritable"
        ]
      }
    },
    "declared_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "https://example.org/sam/v1#NewMatchingEvent",
          "https://example.org/sam/v1#ReservationRecorded"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "time_grid_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "preserves_other_events": {
          "type": "boolean"
        }
      },
      "required": [
        "time_grid_seconds",
        "max_duration_seconds",
        "preserves_other_events"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "create_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+(?![\\s\\S])"
        },
        "baseline_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+(?![\\s\\S])"
        },
        "state_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+(?![\\s\\S])"
        },
        "event_path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+/\\{id\\}(?![\\s\\S])"
        },
        "request_fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
              },
              "transform": {
                "enum": [
                  "identity",
                  "iso_to_epoch_ms",
                  "epoch_ms_to_iso"
                ]
              }
            },
            "required": [
              "source",
              "transform"
            ],
            "additionalProperties": false
          }
        },
        "event_fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
              },
              "transform": {
                "enum": [
                  "identity",
                  "iso_to_epoch_ms",
                  "epoch_ms_to_iso"
                ]
              }
            },
            "required": [
              "source",
              "transform"
            ],
            "additionalProperties": false
          }
        },
        "response_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "writable_field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "events_field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "revision_field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "timestamp_field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        },
        "event_field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?![\\s\\S])"
        }
      },
      "required": [
        "create_path",
        "baseline_path",
        "state_path",
        "event_path",
        "request_fields",
        "event_fields",
        "response_id",
        "writable_field",
        "events_field",
        "revision_field",
        "timestamp_field",
        "event_field"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "max_evidence_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        }
      },
      "required": [
        "max_evidence_age_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "operation_id",
    "capability_id",
    "inputs",
    "preconditions",
    "declared_effects",
    "constraints",
    "binding",
    "observation"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sam/json/contract-v2.schema.json",
  "title": "Finite multi-provider semantic contract v2"
}
