{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/sam/json/contract-v1.schema.json",
  "title": "Semantic Action Manual JSON contract profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "operation_id",
    "capability_id",
    "inputs",
    "preconditions",
    "declared_effects",
    "binding",
    "observation"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|\\\\^`]*(?![\\s\\S])"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "start_time",
          "end_time",
          "title"
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          "https://example.org/sam/v1#PositiveInterval",
          "https://example.org/sam/v1#CalendarWritable"
        ]
      }
    },
    "declared_effects": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "https://example.org/sam/v1#NewMatchingEvent"
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "path": {
          "const": "/events"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "max_evidence_age_seconds"
      ],
      "properties": {
        "path": {
          "const": "/events/{id}"
        },
        "max_evidence_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        }
      }
    }
  }
}
